# ===================================================
# QRFlow Environment Configuration Template
# Copy this file to .env.local for local development
# ===================================================

# [REQUIRED] Supabase Project URL
# Found in Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# [REQUIRED] Supabase Anonymous Public Key
# Used by Edge redirect route & public reads
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# [CRITICAL FOR PRODUCTION] Supabase Service Role Key
# Grants administrative privileges to backend API routes to bypass Row Level Security.
# NEVER expose this key with NEXT_PUBLIC_ prefix! Keep it strictly server-side.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# [REQUIRED] Admin Passcode
# Master secret used to authenticate to /admin and sign session cookies.
# Set a strong, random password for production.
ADMIN_PASSCODE=change-this-to-a-secure-passcode

# [OPTIONAL] Canonical Application URL
# If omitted, QRFlow automatically derives the URL from the incoming request hostname.
# Example for production: https://qrflow.yourdomain.com
# Example for local development: http://localhost:3000
NEXT_PUBLIC_APP_URL=https://yourdomain.com
